digraph Notebook {
    rankdir="TB";
    node [shape=circle, style=filled, fillcolor="#eeeeee", fontname="Helvetica"];
    edge [fontname="Helvetica"];
    "cell_0" [label="C", shape="circle", fillcolor="#eeeeee"];
    "cell_1" [label="D", shape="circle", fillcolor="#eeeeee"];
    "cell_2" [label="E", shape="circle", fillcolor="#eeeeee"];
    "cell_3" [label="H", shape="circle", fillcolor="#eeeeee"];
    "cell_4" [label="J", shape="circle", fillcolor="#eeeeee"];
    "cell_5" [label="K", shape="circle", fillcolor="#eeeeee"];
    "cell_0" -> "cell_1" [label="iters, x, T, E, S, alpha, states"];
    "cell_1" -> "cell_2" [label="pi, T, E"];
    "cell_0" -> "cell_2" [label="states, alpha"];
    "cell_0" -> "cell_3" [label="lines, states, iters, x, alpha"];
    "cell_1" -> "cell_3" [label="T, E"];
    "cell_3" -> "cell_4" [label="lines, states, iters, x, alpha, T, E, outdata"];
    "cell_4" -> "cell_5" [label="lines, states, iters, x, alpha, T, E, outdata"];
}