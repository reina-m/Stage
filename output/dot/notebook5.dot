digraph Notebook {
    rankdir="TB";
    node [shape=circle, style=filled, fillcolor="#eeeeee", fontname="Helvetica"];
    edge [fontname="Helvetica"];
    "cell_0" [label="A", shape="circle", fillcolor="#eeeeee"];
    "cell_1" [label="C", shape="circle", fillcolor="#eeeeee"];
    "cell_0" -> "cell_1" [label="a, b, c"];
}